-- =========================================
-- LOGIC HITBOX (CHẠM LÀ TO, NHẢ LÀ THƯỜNG)
-- =========================================
local priorityParts = { "Head", "HumanoidRootPart", "UpperTorso", "Torso", "LowerTorso", "RootPart", "Body" }
local originalSizes = {}

local function saveOriginalSizes(model)
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") and not originalSizes[part] then
            originalSizes[part] = part.Size
        end
    end
end

local function expandParts(model)
    for _, partName in ipairs(priorityParts) do
        local part = model:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            part.Size = Vector3.new(Settings.HitBoxSize, Settings.HitBoxSize, Settings.HitBoxSize)
        end
    end
end

local function restoreParts(model)
    for _, part in ipairs(model:GetDescendants()) do
        if originalSizes[part] then
            part.Size = originalSizes[part]
            originalSizes[part] = nil
        end
    end
end

local function ExpandAll()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp and plr.Character then
            saveOriginalSizes(plr.Character)
            expandParts(plr.Character)
        end
    end
end

local function RestoreAll()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then
            restoreParts(plr.Character)
        end
    end
end

local isTouching = false
UserInputService.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
