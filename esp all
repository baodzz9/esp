-- =========================================
-- NÚT BẬT TẮT
-- =========================================
local function createToggle(parent, text, settingTable, key, xPos, yPos)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 130, 0, 30)
    btn.Position = UDim2.new(0, xPos, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    btn.Text = text .. "  [" .. (settingTable[key] and "ON" or "OFF") .. "]"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 12
    btn.Parent = parent

    btn.MouseButton1Click:Connect(function()
        settingTable[key] = not settingTable[key]
        btn.Text = text .. "  [" .. (settingTable[key] and "ON" or "OFF") .. "]"
        btn.BackgroundColor3 = settingTable[key] and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(40, 40, 50)
    end)
end

