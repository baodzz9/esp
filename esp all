-- =========================================
-- TẠO ĐỐI TƯỢNG VẼ
-- =========================================
local function CreateObjects()
    return {
        Box = Drawing.new("Square"),
        Tracer = Drawing.new("Line"),
        Name = Drawing.new("Text"),
        Health = Drawing.new("Text")
    }
end

local function SetupESP(plr)
    if plr == lp then return end
    ESP_Objects[plr] = CreateObjects()

    plr.CharacterAdded:Connect(function()
        wait(1)
        if not ESP_Objects[plr] then ESP_Objects[plr] = CreateObjects() end
    end)
end

for _, player in ipairs(Players:GetPlayers()) do
    SetupESP(player)
end

Players.PlayerAdded:Connect(SetupESP)
Players.PlayerRemoving:Connect(function(plr)
    if ESP_Objects[plr] then
        for _, obj in pairs(ESP_Objects[plr]) do obj:Remove() end
        ESP_Objects[plr] = nil
    end
end)

-- =========================================
-- VÒNG LẶP VẼ ESP (ĐƯỜNG KẺ DỌC TỪ TRÊN XUỐNG)
-- =========================================
RunService.RenderStepped:Connect(function()
    -- Đếm số người chơi ở góc phải
    local count = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp and plr.Character then count = count + 1 end
    end
    PlayerCounter.Text = "Players: " .. count

    for plr, Objects in pairs(ESP_Objects) do
        local char = plr.Character

        if Settings.ESP_Enabled and char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Head") then
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            local rootPos, onScreen = camera:WorldToViewportPoint(char.HumanoidRootPart.Position)
            local headPos = camera:WorldToViewportPoint(char.Head.Position)

            if onScreen then
                if Settings.Show_Box then
                    local size = math.abs(headPos.Y - rootPos.Y)
                    Objects.Box.Size = Vector2.new(size / 2, size)
                    Objects.Box.Position = Vector2.new(rootPos.X - size / 4, rootPos.Y - size / 2)
                    Objects.Box.Color = Settings.Box_Color
                    Objects.Box.Visible = true
                else
                    Objects.Box.Visible = false
                end

                -- Đường kẻ thẳng đứng từ đỉnh màn hình xuống (Giống hack FF)
                if Settings.Show_Tracer then
                    Objects.Tracer.From = Vector2.new(headPos.X, 0) -- Điểm bắt đầu: Trên đỉnh màn hình
                    Objects.Tracer.To = Vector2.new(headPos.X, rootPos.Y) -- Điểm kết thúc: Chân người chơi
                    Objects.Tracer.Color = Settings.Tracer_Color
                    Objects.Tracer.Visible = true
                else
                    Objects.Tracer.Visible = false
                end

                if Settings.Show_Name then
                    Objects.Name.Size = 13
                    Objects.Name.Position = Vector2.new(rootPos.X - Objects.Name.TextBounds.X / 2, headPos.Y - 25)
                    Objects.Name.Text = plr.Name
                    Objects.Name.Color = Settings.Name_Color
                    Objects.Name.Visible = true
                else
                    Objects.Name.Visible = false
                end

                if Settings.Show_Health and humanoid then
                    Objects.Health.Size = 12
                    Objects.Health.Position = Vector2.new(rootPos.X - Objects.Health.TextBounds.X / 2, rootPos.Y)
                    Objects.Health.Text = "HP: " .. math.floor(humanoid.Health)
                    Objects.Health.Color = humanoid.Health > 25 and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
                    Objects.Health.Visible = true
                else
                    Objects.Health.Visible = false
                end
            else
                Objects.Box.Visible = false
                Objects.Tracer.Visible = false
                Objects.Name.Visible = false
                Objects.Health.Visible = false
            end
        else
            Objects.Box.Visible = false
            Objects.Tracer.Visible = false
            Objects.Name.Visible = false
            Objects.Health.Visible = false
        end
    end
end)

-- =========================================
-- KÉO THẢ UI VÀ ĐÓNG MỞ
-- =========================================
local dragging = false
local dragInput, mousePos, framePos

TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        mousePos = input.Position
        framePos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)

TitleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - mousePos
        MainFrame.Position = UDim2.new(framePos.X.Scale, framePos.X.Offset + delta.X, framePos.Y.Scale, framePos.Y.Offset + delta.Y)
    end
end)

