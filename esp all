local function createToggle(parent, text, settingTable, key, yPos)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 25)
    btn.Position = UDim2.new(0, 10, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    btn.Text = text .. "  [" .. (settingTable[key] and "ON" or "OFF") .. "]"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 13
    btn.Parent = parent

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 6)
    Corner.Parent = btn

    btn.MouseButton1Click:Connect(function()
        settingTable[key] = not settingTable[key]
        btn.Text = text .. "  [" .. (settingTable[key] and "ON" or "OFF") .. "]"
        btn.BackgroundColor3 = settingTable[key] and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(40, 40, 50)
    end)
end

